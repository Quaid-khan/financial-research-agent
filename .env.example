# ==============================================================================
# FINANCIAL RESEARCH AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your actual values.
# NEVER commit the '.env' file to source control.

# ------------------------------------------------------------------------------
# Google Gemini LLM Configuration (Free Tier)
# ------------------------------------------------------------------------------
# Required for primary agent reasoning, narrative synthesis, and report generation.
# Free Tier API Key: Obtain from https://aistudio.google.com/apikey (no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini LLM model (Free tier eligible model)
# Options: 'gemini-2.0-flash', 'gemini-1.5-flash'
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# SEC EDGAR Regulatory Access (Required by SEC Fair Access Rules)
# ------------------------------------------------------------------------------
# The SEC EDGAR API requires a user-agent header containing your name/organization
# and a valid email address. Requests without this will be rate-limited or blocked.
# Format: "Sample Company Name AdminContact@<sample company domain>.com"
SEC_EDGAR_USER_AGENT=FinancialResearchAgent user@example.com

# ------------------------------------------------------------------------------
# Local Vector Database & Embedding Configurations
# ------------------------------------------------------------------------------
# Hugging Face embedding model used locally for semantic search over filings.
# Default: 'all-MiniLM-L6-v2' (runs locally, lightweight, no API key required).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path where ChromaDB persistent vector database will store embeddings locally.
# Default: './cache/chroma_db' (no API key required).
CHROMA_DB_PATH=./cache/chroma_db

# ------------------------------------------------------------------------------
# Optional Financial Data APIs (Earnings Transcripts & Market Data)
# ------------------------------------------------------------------------------
# Financial Modeling Prep (FMP) API Key:
# Used for earnings call transcripts, financial statements, and company profiles.
# Free tier: 250 requests/day. Obtain from: https://site.financialmodelingprep.com/
# Note: If omitted, mock/cached earnings transcripts will be used.
FMP_API_KEY=

# Alpha Vantage API Key:
# Alternative source for stock prices and fundamental data.
# Free tier: 25 requests/day. Obtain from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub API Key:
# Alternative source for financial news, earnings call dates, and disclosures.
# Free tier available. Obtain from: https://finnhub.io/
FINNHUB_API_KEY=

# ------------------------------------------------------------------------------
# System & Logging Settings
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Directory for caching HTTP responses and SEC raw downloads
CACHE_DIR=./cache
